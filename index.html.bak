<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Cobracut - Ducks Store</title>
  <link rel="stylesheet" href="styles.css" />
  <script defer>
    document.addEventListener('DOMContentLoaded', () => {
      const cart = JSON.parse(localStorage.getItem('cart')) || [];
      const countEl = document.getElementById('cart-count-number');
      if (countEl) countEl.textContent = cart.length;
    });
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
  <header>
    <div class="header-left">
      <a href="index.html">
        <img src="images/Cross.png" alt="SC Design Logo" class="logo" />
      </a>
    </div>
	<nav class="main-nav">
      <ul class="nav-links">
        <li><a href="index.html">Home</a></li>

        <li class="dropdown">
          <a href="apparel.html">Apparel</a>
          <ul class="dropdown-menu">
            <li><a href="product3.html">Slides</a></li>
            <li><a href="ducks-hockey.html">Ducks Hockey</a></li>
            <li><a href="rotherham-ducks.html">Rotherham Ducks</a></li>
            <li><a href="d-logo.html">D-Logo</a></li>
          </ul>
        </li>

        <li><a href="headwear.html">Headwear</a></li>

        <li class="dropdown">
          <a href="#">Accessories</a>
          <ul class="dropdown-menu">
            <li><a href="product2.html">Deskpads</a></li>
            <li><a href="drinkswear.html">Drinkswear</a></li>
            <li><a href="phone-cases.html">Phone Cases</a></li>
          </ul>
        </li>

        <li class="dropdown">
          <a href="#">Homeware</a>
          <ul class="dropdown-menu">
            <li><a href="towels.html">Towels</a></li>
            <li><a href="product5.html">Visor Towels</a></li>
            <li><a href="product1.html">Blankets</a></li>
            <li><a href="product4.html">Cushions</a></li>
          </ul>
        </li>
		<li class="dropdown">
            <a href="#">Account</a>
			<ul class="dropdown-menu">
				<li><a href="#">Login</a></li>
				<li><a href="#">Register</a></li>
				<li><a href="#">My Account</a></li>
			</ul>
		</li>
		
      </ul>
    </nav>
    <a href="cart.html" id="cart-count-link">
      <div id="cart-icon">
        <i class="fas fa-shopping-cart"></i>
        <span id="cart-count-number">0</span>
      </div>
    </a>
	
  </header>


<main>
  <!-- Apparel Range -->
  <section class="product-section">
    <h2 class="section-title">Apparel Range</h2>
    <div class="product-grid">
      <a href="product3.html" class="product-card">
        <img src="images/Ducks Slides.png" alt="Slides" class="product-image" />
        <div class="product-info">
          <div class="product-title">Slides</div>
        </div>
      </a>
      <a href="ducks-hockey.html" class="product-card">
        <img src="images/Ducks T-shirt.png" alt="Ducks Hockey" class="product-image" />
        <div class="product-info">
          <div class="product-title">Ducks Hockey</div>
        </div>
      </a>
      <a href="rotherham-ducks.html" class="product-card">
        <img src="images/rotherhamducks2.png" alt="Rotherham Ducks" class="product-image" />
        <div class="product-info">
          <div class="product-title">Rotherham Ducks</div>
        </div>
      </a>
    </div>
  </section>

  <!-- Headwear -->
  <section class="product-section">
    <h2 class="section-title">Headwear</h2>
    <div class="product-grid">
      <a href="headwear.html" class="product-card">
        <img src="images/Ducks Hat.png" alt="Headwear" class="product-image" />
        <div class="product-info">
          <div class="product-title">Headwear</div>
        </div>
      </a>
    </div>
  </section>

  <!-- Accessories -->
  <section class="product-section">
    <h2 class="section-title">Accessories</h2>
    <div class="product-grid">
      <a href="product2.html" class="product-card">
        <img src="images/Desk.png" alt="Deskpad" class="product-image" />
        <div class="product-info">
          <div class="product-title">Deskpad</div>
        </div>
      </a>
      <a href="drinkswear.html" class="product-card">
        <img src="images/drinkswear.png" alt="Drinkswear" class="product-image" />
        <div class="product-info">
          <div class="product-title">Drinkswear</div>
        </div>
      </a>
      <a href="phone-cases.html" class="product-card">
        <img src="images/phonecases.png" alt="Phonecase" class="product-image" />
        <div class="product-info">
          <div class="product-title">Phone Cases</div>
        </div>
      </a>
    </div>
  </section>

  <!-- Homeware -->
  <section class="product-section">
    <h2 class="section-title">Homeware</h2>
    <div class="product-grid">
      <a href="product1.html" class="product-card">
        <img src="images/quackattack.png" alt="Blanket" class="product-image" />
        <div class="product-info">
          <div class="product-title">Blanket</div>
        </div>
      </a>
      <a href="product4.html" class="product-card">
        <img src="images/Pillow.png" alt="Cushion" class="product-image" />
        <div class="product-info">
          <div class="product-title">Cushion</div>
        </div>
      </a>
      <a href="product5.html" class="product-card">
        <img src="images/visortowels.png" alt="Visor Towel" class="product-image" />
        <div class="product-info">
          <div class="product-title">Visor Towel</div>
        </div>
      </a>
    </div>
  </section>
</main>
</body>
</html>