<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Cushions - Cobracut x Ducks Store</title>
  <link rel="stylesheet" href="styles.css" />
  <script src="cushions.js" defer></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
  <header>
    <div class="header-left">
      <a href="index.html">
        <img src="images/Cross.png" alt="SC Design Logo" class="logo" />
      </a>
    </div>
	<nav class="main-nav">
      <ul class="nav-links">
        <li><a href="index.html">Home</a></li>

        <li class="dropdown">
          <a href="#">Apparel</a>
          <ul class="dropdown-menu">
            <li><a href="slides.html">Slides</a></li>
            <li><a href="ducks-hockey.html">Ducks Hockey</a></li>
            <li><a href="rotherham-ducks.html">Rotherham Ducks</a></li>
            <li><a href="d-logo.html">D-Logo</a></li>
          </ul>
        </li>

        <li><a href="headwear.html">Headwear</a></li>

        <li class="dropdown">
          <a href="#">Accessories</a>
          <ul class="dropdown-menu">
            <li><a href="deskpad.html">Deskpads</a></li>
            <li><a href="drinkswear.html">Drinkswear</a></li>
            <li><a href="phone-cases.html">Phone Cases</a></li>
          </ul>
        </li>

        <li class="dropdown">
          <a href="#">Homeware</a>
          <ul class="dropdown-menu">
            <li><a href="towels.html">Towels</a></li>
            <li><a href="product5.html">Visor Towels</a></li>
            <li><a href="blankets.html">Blankets</a></li>
            <li><a href="slides.html">Cushions</a></li>
          </ul>
        </li>
		<li class="dropdown">
            <a href="#">Account</a>
			<ul class="dropdown-menu">
				<li><a href="#">Login</a></li>
				<li><a href="#">Register</a></li>
				<li><a href="#">My Account</a></li>
			</ul>
		</li>
		
      </ul>
    </nav>
    <a href="cart.html" id="cart-count-link">
      <div id="cart-icon">
        <i class="fas fa-shopping-cart"></i>
        <span id="cart-count-number">0</span>
      </div>
    </a>
	
  </header>

  <main class="product-page">
    <div class="product-image">
      <img id="mainImage" src="images/Pillow.png" alt="Ducks Pillow Image" />
    </div>

    <div class="product-options">
      <h2 class="product-title">Cushion</h2>

      <label for="surname-input">Surname:</label>
      <input type="text" id="surname-input" placeholder="Enter surname" />

      <label for="custom-number">Enter Number (max 2 digits):</label>
      <input type="text" id="custom-number" maxlength="2" pattern="[0-9]{1,2}" placeholder="Enter 2 digits" />

      <label for="insert-option">Include Insert:</label>
      <select id="insert-option">
        <option value="no">No</option>
        <option value="yes">Yes</option>
      </select>

      <p id="price-display">£0.00</p>
      <button id="add-to-cart-btn">Add to Cart</button>
    </div>
  </main>
</body>
</html>
