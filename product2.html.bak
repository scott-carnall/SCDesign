<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Deskpad - SC Design</title>
  <link rel="stylesheet" href="styles.css" />
  <script src="product2.js" defer></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
  <header>
    <div class="header-left">
      <a href="index.html">
        <img src="images/cobracut.png" alt="SC Design Logo" class="logo" />
      </a>
    </div>
	<nav class="main-nav">
      <ul class="nav-links">
        <li><a href="index.html">Home</a></li>

        <li class="dropdown">
          <a href="#">Apparel</a>
          <ul class="dropdown-menu">
            <li><a href="product3.html">Slides</a></li>
            <li><a href="ducks-hockey.html">Ducks Hockey</a></li>
            <li><a href="rotherham-ducks.html">Rotherham Ducks</a></li>
            <li><a href="d-logo.html">D-Logo</a></li>
          </ul>
        </li>

        <li><a href="headwear.html">Headwear</a></li>

        <li class="dropdown">
          <a href="#">Accessories</a>
          <ul class="dropdown-menu">
            <li><a href="product2.html">Deskpads</a></li>
            <li><a href="drinkswear.html">Drinkswear</a></li>
            <li><a href="phone-cases.html">Phone Cases</a></li>
          </ul>
        </li>

        <li class="dropdown">
          <a href="#">Homeware</a>
          <ul class="dropdown-menu">
            <li><a href="towels.html">Towels</a></li>
            <li><a href="product5.html">Visor Towels</a></li>
            <li><a href="product1.html">Blankets</a></li>
            <li><a href="product4.html">Cushions</a></li>
          </ul>
        </li>
		<li class="dropdown">
            <a href="#">Account</a>
			<ul class="dropdown-menu">
				<li><a href="#">Login</a></li>
				<li><a href="#">Register</a></li>
				<li><a href="#">My Account</a></li>
			</ul>
		</li>
		
      </ul>
    </nav>
    <a href="cart.html" id="cart-count-link">
      <div id="cart-icon">
        <i class="fas fa-shopping-cart"></i>
        <span id="cart-count-number">0</span>
      </div>
    </a>
	
  </header>

  <main class="product-page">
    <div class="product-image">
      <img id="mainImage" src="images/Desk.png" alt="Main Image" />
    </div>

    <div class="product-options">
      <h2 class="product-title">Deskpad</h2>

      <label for="size-select">Size:</label>
      <select id="size-select">
        <option value="small">30x25</option>
        <option value="medium">60x30</option>
        <option value="large">80x40</option>
		<option value="xlarge">90x40</option>
      </select>

      <p id="price-display">£0.00</p>
      <button id="add-to-cart-btn">Add to Cart</button>
    </div>
  </main>
</body>
</html>
